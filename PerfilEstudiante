    <!-- JAVASCRIPT LOGIC -->
    <script>
        // CANVASES & AMBIENT FLOATING DUST PARTICLES
        const canvas = document.getElementById('candyCanvas');
        const ctx = canvas.getContext('2d');

        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        let particles = [];
        const colors = ['#FF69B4', '#2DD4BF', '#FBBF24', '#A855F7', '#FF4081', '#FFFFFF'];

        class CandyParticle {
            constructor() {
                this.reset();
            }

            reset() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.size = Math.random() * 6 + 3;
                this.speedY = Math.random() * 0.8 + 0.2;
                this.speedX = Math.random() * 0.6 - 0.3;
                this.color = colors[Math.floor(Math.random() * colors.length)];
                this.shape = Math.floor(Math.random() * 3);
                this.rotation = Math.random() * Math.PI * 2;
                this.rotationSpeed = (Math.random() - 0.5) * 0.05;
            }

            update() {
                this.y += this.speedY;
                this.x += this.speedX;
                this.rotation += this.rotationSpeed;

                if (this.y > height + 20) {
                    this.y = -10;
                    this.x = Math.random() * width;
                }
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);
                ctx.fillStyle = this.color;
                ctx.globalAlpha = 0.6;

                if (this.shape === 0) {
                    ctx.beginPath();
                    ctx.arc(0, 0, this.size / 2, 0, Math.PI * 2);
                    ctx.fill();
                } else if (this.shape === 1) {
                    ctx.fillRect(-this.size / 2, -this.size / 4, this.size * 1.4, this.size / 2);
                } else {
                    ctx.beginPath();
                    ctx.roundRect(-this.size/2, -this.size/2, this.size, this.size, [2]);
                    ctx.fill();
                }

                ctx.restore();
            }
        }

        // Create ambient candy particles
        for (let i = 0; i < 25; i++) {
            particles.push(new CandyParticle());
        }

        function animateCanvas() {
            ctx.clearRect(0, 0, width, height);
            
            particles.forEach(p => {
                p.update();
                p.draw();
            });

            requestAnimationFrame(animateCanvas);
        }

        // Start Animation Loop on Window Load
        window.onload = function() {
            animateCanvas();
        };
    </script>
