    <style>
        /* Typography & Custom Scrollbar */
        body {
            font-family: 'Poppins', sans-serif;
            overflow-x: hidden;
            color: #2e1065;
        }

        ::-webkit-scrollbar {
            width: 12px;
        }
        ::-webkit-scrollbar-track {
            background: #2e1065;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(to bottom, #FF69B4, #2DD4BF);
            border-radius: 6px;
            border: 2px solid #2e1065;
        }

        /* Glitch Effect on Title */
        .glitch-text {
            position: relative;
            display: inline-block;
        }
        .glitch-text::before, .glitch-text::after {
            content: attr(data-text);
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            clip: rect(0, 0, 0, 0);
        }
        .glitch-active::before {
            left: 3px;
            text-shadow: -2px 0 #2DD4BF;
            animation: glitch-anim 0.3s infinite linear alternate-reverse;
        }
        .glitch-active::after {
            left: -3px;
            text-shadow: 2px 0 #FF69B4;
            animation: glitch-anim2 0.3s infinite linear alternate-reverse;
        }

        @keyframes glitch-anim {
            0% { clip: rect(10px, 9999px, 30px, 0); transform: skew(0.3deg); }
            50% { clip: rect(40px, 9999px, 70px, 0); transform: skew(0.8deg); }
            100% { clip: rect(70px, 9999px, 90px, 0); transform: skew(0.1deg); }
        }
        @keyframes glitch-anim2 {
            0% { clip: rect(60px, 9999px, 80px, 0); transform: skew(-0.5deg); }
            50% { clip: rect(10px, 9999px, 40px, 0); transform: skew(-0.2deg); }
            100% { clip: rect(30px, 9999px, 50px, 0); transform: skew(-0.7deg); }
        }

        /* Candy Stripe Border */
        .candy-stripe-border {
            border: 6px solid transparent;
            border-image: repeating-linear-gradient(
                45deg,
                #FF4081,
                #FF4081 12px,
                #FFFFFF 12px,
                #FFFFFF 24px,
                #2DD4BF 24px,
                #2DD4BF 36px
            ) 10;
        }

        /* Licorice Stitch Stitching Effect (Vanellope's hoodie stitch) */
        .hoodie-stitch {
            border: 3px dashed #FF4081;
            box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.4);
        }

        /* Candy Sprinkles Background */
        .sprinkles-bg {
            background-image: 
                radial-gradient(#FF69B4 15%, transparent 16%),
                radial-gradient(#2DD4BF 15%, transparent 16%),
                radial-gradient(#FBBF24 15%, transparent 16%),
                radial-gradient(#A855F7 15%, transparent 16%);
            background-size: 60px 60px;
            background-position: 0 0, 30px 30px, 20px 40px, 40px 10px;
        }

        /* Glassmorphism Card Style */
        .sugar-card {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(8px);
            border: 3px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 10px 25px -5px rgba(124, 58, 237, 0.3), 0 8px 10px -6px rgba(236, 72, 153, 0.2);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .sugar-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px -5px rgba(45, 212, 191, 0.4), 0 10px 12px -5px rgba(236, 72, 153, 0.4);
        }

        /* Custom Buttons */
        .btn-arcade {
            position: relative;
            transition: all 0.1s ease;
            box-shadow: 0 6px 0 #10B981, 0 8px 15px rgba(0,0,0,0.3);
        }
        .btn-arcade:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #10B981, 0 3px 6px rgba(0,0,0,0.3);
        }

        .btn-pink-arcade {
            box-shadow: 0 6px 0 #BE185D, 0 8px 15px rgba(0,0,0,0.3);
        }
        .btn-pink-arcade:active {
            transform: translateY(4px);
