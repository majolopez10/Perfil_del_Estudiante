            0%, 100% { filter: drop-shadow(0 0 8px rgba(45, 212, 191, 0.6)); }
            50% { filter: drop-shadow(0 0 16px rgba(255, 105, 180, 0.8)); }
        }
        .candy-glow {
            animation: pulse-glow 3s infinite ease-in-out;
